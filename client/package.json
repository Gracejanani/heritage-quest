{
  "name": "heritage-quest-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed:supabase": "node scripts/seed-supabase.mjs",
